# Template for your API keys. Copy this file to secrets.toml in this folder and fill it in.
# secrets.toml (and .env) are listed in .gitignore: the real file must NEVER be committed.
# On Streamlit Community Cloud, paste the same two lines into the app's Secrets settings instead.
# One key is enough; with both, the second provider is used if the first is busy.
GEMINI_API_KEY = "your-gemini-key-here"
GROQ_API_KEY = "your-groq-key-here"
