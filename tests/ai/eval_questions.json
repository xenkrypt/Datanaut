 {
  "id": "weekday_weekend_power",
  "question": "Is power higher on weekdays or weekends? Compare the averages.",
  "category": "compare",
  "reference_query": {
   "value_columns": [
    "global_active_power"
   ],
   "aggregation": "mean",
   "compare": {
    "label_a": "weekday",
    "filters_a": [
     {
      "column": "weekday",
      "operator": "between",
      "values": [
       "0",
       "4"
      ]
     }
    ],
    "label_b": "weekend",
    "filters_b": [
     {
      "column": "weekday",
      "operator": "in",
      "values": [
       "5",
       "6"
      ]
     }
    ]
   }
  },
  "expect": {
   "type": "table",
   "columns": [
    "group",
    "global_active_power"
   ],
   "rows": [
    [
     "weekday",
     0.869723383084577
    ],
    [
     "weekend",
     1.0724007490636704
    ]
   ]
  }
 },
